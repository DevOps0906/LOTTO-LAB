# 이름만 기록한다. 실제 값은 배포 환경 변수 또는 .env.local(커밋 금지)에 둔다.
# Cloudflare Turnstile 사이트 키(공개 키). 로컬 개발은 Cloudflare 공개 테스트 키 1x00000000000000000000AA 사용 가능.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# A-15 POST /v1/waitlist — Edge Function URL (로컬 예: http://127.0.0.1:54521/functions/v1/waitlist)
NEXT_PUBLIC_WAITLIST_API_URL=
# A-19 POST /v1/waitlist/confirm — Edge Function URL (로컬 예: http://127.0.0.1:54521/functions/v1/waitlist-confirm)
NEXT_PUBLIC_WAITLIST_CONFIRM_URL=
