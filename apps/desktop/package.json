{
  "name": "@lotto-lab/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "tauri": "tauri",
    "check:release": "node scripts/check-release.mjs",
    "build:release": "node scripts/release-config.mjs && tauri build --config src-tauri/tauri.release.conf.json"
  },
  "dependencies": {
    "@lotto-lab/app-core": "workspace:*",
    "@lotto-lab/design-tokens": "workspace:*",
    "@lotto-lab/ui": "workspace:*",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@tauri-apps/plugin-store": "2.5.1",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
