<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 백업 규칙: 클라우드 백업·기기 이전 모두 앱 데이터를 제외한다(allowBackup=false와 함께). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
